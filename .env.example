# Copy to .env (gitignored) and fill in. OpenJarvis does not auto-load .env:
# export it into the shell that runs `jarvis` / `jarvis serve`, e.g.
#   set -a; source .env; set +a
# The scheduled 07:00 digest only sees keys present in the scheduler's
# environment, so also export them from your shell profile or service unit.

# Cartesia text-to-speech (morning digest voice). https://play.cartesia.ai
CARTESIA_API_KEY=

# Cartesia voice ID for the digest (an Indian-English female voice).
# Not read from the environment: copy it into digest.voice_id in
# ~/.openjarvis/config.toml. Kept here so the key and voice live together.
CARTESIA_VOICE_ID=

# Optional: Cartesia synthesis language (defaults to "en").
# CARTESIA_LANGUAGE=en
